{$DOMAIN} {

  # Authentik outpost endpoints (required by forward_auth)
  reverse_proxy /outpost.goauthentik.io/* http://authentik_proxy:9000

  # /webui protected by forward_auth
  handle_path /webui* {
    forward_auth http://authentik_proxy:9000 {
      uri /outpost.goauthentik.io/auth/caddy
      copy_headers X-Authentik-Email X-Authentik-Name X-Authentik-Groups
    }
    reverse_proxy http://openwebui:8080
  }

  # /api - OpenAI-compatible API for agents (port 4000)
  # Used by OpenWebUI to call the agent backend
  handle_path /api* {
    forward_auth http://authentik_proxy:9000 {
      uri /outpost.goauthentik.io/auth/caddy
      copy_headers X-Authentik-Email X-Authentik-Name X-Authentik-Groups
    }
    reverse_proxy http://backend:4000
  }

  # /admin - Admin UI and management APIs (port 8000)
  handle_path /admin* {
    forward_auth http://authentik_proxy:9000 {
      uri /outpost.goauthentik.io/auth/caddy
      copy_headers X-Authentik-Email X-Authentik-Name X-Authentik-Groups
    }
    reverse_proxy http://backend:8000
  }

  # /rag protected by forward_auth, strips /rag prefix before forwarding
  # Client: /rag/health -> Backend: /health
  # Client: /rag/inject -> Backend: /inject
  handle_path /rag* {
    forward_auth http://authentik_proxy:9000 {
      uri /outpost.goauthentik.io/auth/caddy
      copy_headers X-Authentik-Email X-Authentik-Name X-Authentik-Groups
    }
    reverse_proxy http://rag_mcp_service:5001
  }

  # /hyperparam - Hyperparameter advisor MCP service (port 5020)
  handle_path /hyperparam* {
    forward_auth http://authentik_proxy:9000 {
      uri /outpost.goauthentik.io/auth/caddy
      copy_headers X-Authentik-Email X-Authentik-Name X-Authentik-Groups
    }
    reverse_proxy http://hyperparam_advisor_mcp_service:5020
  }

  respond 404
}

# Authentik UI on /auth path (same domain)
{$DOMAIN}/auth* {
  reverse_proxy http://authentik_server:9000
}
